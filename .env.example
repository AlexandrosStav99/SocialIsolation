# TalkPoint application runtime. Use development for local next dev, demo for the
# controlled university build, and production only with validated production configuration.
TALKPOINT_RUNTIME_MODE=development

# Synthetic fallback is allowed only in development/demo. Production startup requires false.
TALKPOINT_ALLOW_SYNTHETIC_DIRECTORY_FALLBACK=true

# Server-side only. Keep false outside controlled synthetic demonstrations.
# This is NOT authentication. Never use the preview with real provider data.
TALKPOINT_ENABLE_DEMO_DASHBOARD=false

# Optional PUBLIC browser token for the synthetic map. Leave blank for offline demo.
# Use a restricted Mapbox public token with allowed URLs and minimal read scopes.
# Never put a secret token here. Set before next build if enabling the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Phase 1 durable store. Server-side only.
# Local development example. Production rejects local/placeholder database configuration.
DATABASE_URL=postgresql://talkpoint:change-me@localhost:5432/talkpoint

# Payload secret is server-side only. Use a long random value outside development.
PAYLOAD_SECRET=change-me

# Ephemeral session lifetime is configuration, not the final production retention policy.
# This development/demo default can be changed without changing the data model.
TALKPOINT_EPHEMERAL_SESSION_TTL_MINUTES=120

# Server-side only. Never expose to the browser.
OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=gpt-5.4-mini
