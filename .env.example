# TalkPoint application runtime. Use development for local next dev, demo for the
# controlled university build, and production only with validated production configuration.
TALKPOINT_RUNTIME_MODE=development

# Synthetic fallback is allowed only in development/demo. Production startup requires false.
TALKPOINT_ALLOW_SYNTHETIC_DIRECTORY_FALLBACK=true

# Server-side only. Keep false outside controlled synthetic demonstrations.
# This is NOT authentication. Never use the preview with real provider data.
TALKPOINT_ENABLE_DEMO_DASHBOARD=false

# Optional PUBLIC browser token for the synthetic map. Leave blank for offline demo.
# Use a restricted Mapbox public token with allowed URLs and minimal read scopes.
# Never put a secret token here. Set before next build if enabling the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Phase 1 durable store. Server-side only.
# Local development example. Production rejects local/placeholder database configuration.
DATABASE_URL=postgresql://talkpoint:change-me@localhost:5432/talkpoint

# Payload secret is server-side only. Use a long random value outside development.
PAYLOAD_SECRET=change-me

# Ephemeral session lifetime is configuration, not the final production retention policy.
# This development/demo default can be changed without changing the data model.
TALKPOINT_EPHEMERAL_SESSION_TTL_MINUTES=120

# Server-side only. Never expose to the browser.
OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=gpt-5.4-mini


# --- Production safety gate ---
# Server-side operational enable only. This flag cannot self-approve safety content:
# version-controlled qualified-review evidence/configuration must also pass validation.
TALKPOINT_PRODUCTION_SAFETY_ENABLED=false

# --- Production privacy/legal gate ---
# Server-side operational enable only. This flag cannot self-approve legal/privacy content.
# Version-controlled authorised review evidence, consent version and retention values must also match.
TALKPOINT_PRODUCTION_PRIVACY_ENABLED=false

# --- Production assisted-contact configuration ---
# Required only when configuring the production handoff boundary. These are server-side values.
# Do not treat example/inventory presence as approval to enable live handoff.
TALKPOINT_PRODUCTION_CONSENT_VERSION=
TALKPOINT_HANDOFF_CREDENTIAL_SECRET=

# --- Production API / ingress hardening ---
# Canonical public HTTPS origin, for example https://talkpoint.example
TALKPOINT_PUBLIC_APP_ORIGIN=

# Header name that the selected trusted ingress strips/overwrites with a validated client IP.
# Do not blindly use x-forwarded-for unless the real ingress contract guarantees it.
TALKPOINT_TRUSTED_CLIENT_IP_HEADER=

# Dedicated >=32-character server-side HMAC secret for rate-limit bucket identities.
TALKPOINT_RATE_LIMIT_HASH_SECRET=

# --- Retention automation inventory ---
# Exact values require privacy/legal approval. There are intentionally no legal defaults.
TALKPOINT_RETENTION_CONTACT_REQUEST_DAYS=
TALKPOINT_RETENTION_CONSENT_RECORD_DAYS=
TALKPOINT_RETENTION_PROVIDER_AUDIT_DAYS=
TALKPOINT_RETENTION_ANONYMOUS_ANALYTICS_DAYS=

# Scheduler gate. Leave false until approved values and production scheduling are configured.
TALKPOINT_RETENTION_AUTOMATION_ENABLED=false

# Optional operator-side post-deploy verifier target. Prefer passing the origin as a CLI argument.
TALKPOINT_DEPLOY_VERIFY_ORIGIN=
